APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://chargegrid:chargegrid@postgis:5432/chargegrid
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=chargegrid-raw
# dev MinIO root user; use scoped IAM credentials in prod
S3_ACCESS_KEY=chargegrid
S3_SECRET_KEY=chargegrid123
VALHALLA_URL=http://valhalla:8002
MARTIN_URL=http://martin:3000
MLFLOW_TRACKING_URI=http://mlflow:5000
LANGFUSE_HOST=http://langfuse:3000

# required in every non-dev environment; auto-generate and store in Secrets Manager/SSM
JWT_SECRET=

# Places, Routes, Geocoding, Solar (server-side)
GOOGLE_MAPS_SERVER_KEY=
# Solar comes from NASA POWER; set true to also call Google Solar (needs the Solar API
# enabled on the key's Google Cloud project).
GOOGLE_SOLAR_ENABLED=false
# Maps JS only, referrer-restricted
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAP_ID=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
TOMTOM_API_KEY=
OCM_API_KEY=
DATA_GOV_IN_API_KEY=
# One token per operator in config/ocpi_operators.yaml, e.g. OCPI_TOKEN_ACME=

# Agents (Phase 9). Only the anthropic adapter is built. Leave the model names blank to
# use config/agents.yaml (planner claude-opus-5-5; specialists and report
# claude-sonnet-5); LLM_MODEL_REPORT also sets the specialists' model.
LLM_PROVIDER=anthropic
LLM_MODEL_PLANNER=
LLM_MODEL_REPORT=
# Needed for /assistant; restart the api service after setting it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

COST_CAP_MONTHLY_INR_GOOGLE=
COST_CAP_MONTHLY_INR_LLM=
COST_CAP_PER_RUN_INR=
